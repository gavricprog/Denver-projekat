<Window x:Class="Milan_Denver_igraci.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:notifications="clr-namespace:Notification.Wpf.Controls;assembly=Notification.Wpf"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Width="500"
        Height="550"
        MouseDown="Window_MouseDown">

    <Border CornerRadius="15" Background="#1e293b" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
        </Border.Effect>

        <Grid>

            <!-- NOTIFICATIONS -->
            <notifications:NotificationArea
                x:Name="WindowNotificationArea"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10"
                MaxItems="3"/>

            <!-- MAIN CONTENT -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

                <!-- LOGO -->
                <Image Source="pack://application:,,,/Assets/denver2.png"
                       Height="120"
                       Stretch="Uniform"
                       Margin="0,0,0,15"/>

                <!-- TITLE -->
                <TextBlock Text="Denver Club"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <!-- USERNAME -->
                <TextBox x:Name="UserTextBox"
                         Height="35"
                         Padding="10"
                         Background="#334155"
                         Foreground="White"
                         BorderThickness="0"
                         FontSize="14"
                         Text="Username"
                         Margin="0,0,0,15"
                         GotFocus="UserTextBox_GotFocus"
                         LostFocus="UserTextBox_LostFocus"/>

                <!-- PASSWORD -->
                <PasswordBox x:Name="PasswordPasswordBox"
                             Height="35"
                             Padding="10"
                             Background="#334155"
                             Foreground="White"
                             BorderThickness="0"
                             FontSize="14"
                             Margin="0,0,0,15"/>

                <!-- SIGN IN -->
                <Button Content="Sign in"
                        Height="40"
                        Background="#f59e0b"
                        Foreground="Black"
                        FontWeight="Bold"
                        Click="Submit"
                        Margin="0,0,0,10">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#f59e0b"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#d97706"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- EXIT -->
                <Button Content="Exit"
                        Height="35"
                        Background="#ef4444"
                        Foreground="White"
                        Click="Exit"/>

            </StackPanel>

        </Grid>
    </Border>
</Window>