<Window x:Class="Milan_Denver_igraci.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Milan_Denver_igraci"
        xmlns:notifications="clr-namespace:Notification.Wpf.Controls;assembly=Notification.Wpf"
        mc:Ignorable="d"
        WindowStyle="None"
        Title="MainWindow" Height="450" Width="450"
        AllowsTransparency="True"
        Background="Transparent"
        x:Name="MainWINDOW"
        >
    <Canvas
       Width="450" 
       Height="450">
        <Canvas.Resources>
            <DropShadowEffect
               x:Key="MouseOverDropShadowEffect"
               Direction="320"
               Opacity="80"
               ShadowDepth="10"
               Color="Black"
            ></DropShadowEffect>
        </Canvas.Resources>

        <Path
          Name="UiPath"
          Fill="Orange"
          Stroke="Yellow"
          StrokeThickness="2" Height="450" Stretch="Fill" Width="450" RenderTransformOrigin="0.512,0.479" HorizontalAlignment="Center" VerticalAlignment="Center"
        >
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="50,0">
                        <ArcSegment Point="50,100" Size="50,50" SweepDirection="Clockwise" />
                    </PathFigure>
                    <PathFigure StartPoint="50,100">
                        <ArcSegment Point="50,0" Size="50,50" SweepDirection="Clockwise" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <notifications:NotificationArea
          x:Name="WindowNotificationArea"
            Panel.ZIndex="1000"
            MaxItems="3"
            Position="TopRight"/>
       
        
        <TextBox 
            x:Name="UserTextBox"
            Width="200"
            Height="22"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" Canvas.Left="125" Canvas.Top="225"
        ></TextBox>

        <PasswordBox 
           x:Name="PasswordPasswordBox"
           Width="200"
           Height="22"
           HorizontalAlignment="Center"
           VerticalAlignment="Top" Canvas.Left="125" Canvas.Top="271"
        ></PasswordBox>

        <Label x:Name="EmailName" Content="User:" HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.Left="66" Canvas.Top="221" FontWeight="Bold" FontSize="15" FontFamily="Comic Sans MS" RenderTransformOrigin="0.237,0.523">

        </Label>

        <Label x:Name="Password1" Content="Password:" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="39" Canvas.Top="267" FontWeight="Bold" FontSize="15" FontFamily="Comic Sans MS">

        </Label>

        <Button  Click="Submit" Content="Sign in" Canvas.Left="125" Canvas.Top="306" Width="200" Height="30" FontWeight="ExtraBold" FontSize="15" FontFamily="Comic Sans MS" HorizontalAlignment="Left" VerticalAlignment="Top" ></Button>

        <Button Click="Exit" Content="Exit" FontWeight="ExtraBold" Height="30" RenderTransformOrigin="0.5,0.5" Canvas.Top="356" Width="42" FontSize="15" Canvas.Left="204" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Comic Sans MS">

        </Button>

        <Image Source="C:\Users\HP\Desktop\denver2.png" Stretch="Fill" Width="256" Height="141" Canvas.Left="97" Canvas.Top="44" HorizontalAlignment="Left" VerticalAlignment="Top"/>

    </Canvas>
</Window>
