<Window x:Class="Milan_Denver_igraci.AddPlayer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:notifications="clr-namespace:Notification.Wpf.Controls;assembly=Notification.Wpf"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <Border Background="#0f172a" CornerRadius="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.3"/>
        </Border.Effect>

        <Grid>

            <!-- NOTIFICATIONS -->
            <notifications:NotificationArea
                x:Name="AddNotificationArea"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10"
                MaxItems="3"/>

            <!-- HEADER -->
            <TextBlock Text="Add Player"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Left"
                       Margin="10"/>

            <!-- MAIN GRID -->
            <Grid Margin="0,50,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE -->
                <StackPanel Grid.Column="0" Margin="10">

                    <TextBlock Text="Ime" Foreground="White"/>
                    <TextBox x:Name="txtIme" Margin="0,5,0,10" Height="30"
                             Background="#334155" Foreground="White" BorderThickness="0"/>

                    <TextBlock Text="Prezime" Foreground="White"/>
                    <TextBox x:Name="txtPrezime" Margin="0,5,0,10" Height="30"
                             Background="#334155" Foreground="White" BorderThickness="0"/>

                    <TextBlock Text="Slika" Foreground="White"/>
                    <Button Content="Izaberi sliku"
                            Click="IzaberiSliku_Click"
                            Margin="0,5,0,10"
                            Background="#3b82f6"
                            Foreground="White"/>

                    <Image x:Name="SelectedImage"
                           Height="120"
                           Stretch="Uniform"
                           Margin="0,10,0,10"/>

                    <Button Content="Potvrdi"
                            Click="Potvrdi_Click"
                            Height="40"
                            Background="#22c55e"
                            Foreground="White"
                            Margin="0,10,0,5"/>

                    <Button Content="Odustani"
                            Click="Odustani_Click"
                            Height="40"
                            Background="#ef4444"
                            Foreground="White"/>
                </StackPanel>

                <!-- RIGHT SIDE -->
                <StackPanel Grid.Column="1" Margin="10">

                    <TextBlock Text="Detalji"
                               Foreground="White"
                               Margin="0,0,0,5"/>

                    <RichTextBox x:Name="rtbDetalji"
                                 Height="200"
                                 Background="#1e293b"
                                 Foreground="White"
                                 BorderThickness="0"
                                 TextChanged="rtbDetalji_TextChanged"/>

                    <!-- TOOLBAR -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                        <Button Click="Bold_Click">
                            <materialDesign:PackIcon Kind="FormatBold"/>
                        </Button>

                        <Button Click="Italic_Click">
                            <materialDesign:PackIcon Kind="FormatItalic"/>
                        </Button>

                        <Button Click="Underline_Click">
                            <materialDesign:PackIcon Kind="FormatUnderline"/>
                        </Button>

                        <Button Content="Boja"
                                Click="ChangeTextColor_Click"
                                Margin="10,0,0,0"/>

                        <Button Click="ChangeFont_Click">
                            <materialDesign:PackIcon Kind="FormatFont"/>
                        </Button>

                        <Button Content="⬆"
                                Click="IncreaseFontSize_Click"/>

                        <Button Content="⬇"
                                Click="DecreaseFontSize_Click"/>
                    </StackPanel>

                    <Rectangle x:Name="ColorRectangle"
                               Width="20"
                               Height="20"
                               Margin="0,10,0,0"
                               Stroke="Black"/>

                    <StatusBar Margin="0,10,0,0">
                        <StatusBarItem>
                            <TextBlock x:Name="WordCountTextBlock"/>
                        </StatusBarItem>
                    </StatusBar>

                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>