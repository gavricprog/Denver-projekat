<Window x:Class="Milan_Denver_igraci.Info"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="600"
        Height="400"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <Border Background="#0f172a" CornerRadius="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
        </Border.Effect>

        <Grid>

            <!-- HEADER -->
            <TextBlock Text="Player Info"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="10"/>

            <!-- MAIN -->
            <Grid Margin="0,50,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel Grid.Column="0" Margin="10">

                    <TextBlock Text="Ime" Foreground="White"/>
                    <TextBlock x:Name="txtIme"
                               Foreground="#cbd5f5"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Prezime" Foreground="White"/>
                    <TextBlock x:Name="txtPrezime"
                               Foreground="#cbd5f5"
                               Margin="0,0,0,10"/>

                    <Image x:Name="SelectedImage"
                           Height="120"
                           Stretch="Uniform"
                           Margin="0,10,0,0"/>
                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="1" Margin="10">

                    <TextBlock Text="Detalji"
                               Foreground="White"
                               Margin="0,0,0,5"/>

                    <Border Background="#1e293b"
                            CornerRadius="10"
                            Padding="10">

                        <RichTextBox x:Name="rtbDetalji"
                                     IsReadOnly="True"
                                     Background="#1e293b"
                                     Foreground="White"
                                     BorderThickness="0"
                                     Height="200"/>
                    </Border>

                    <Button Content="Zatvori"
                            Click="Zatvori_Click"
                            Height="40"
                            Margin="0,15,0,0"
                            Background="#ef4444"
                            Foreground="White"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>