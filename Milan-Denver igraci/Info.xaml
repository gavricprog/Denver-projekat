<Window x:Class="Milan_Denver_igraci.Info"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Milan_Denver_igraci"
        xmlns:notifications="clr-namespace:Notification.Wpf.Controls;assembly=Notification.Wpf"
        mc:Ignorable="d"
        Title="Info" Height="300" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Grid>
        <Path
            Name="UPath2"
            Fill="Yellow"
            Stroke="Blue"
            StrokeThickness="2"
            Height="300" Width="400" HorizontalAlignment="Center" Stretch="Fill" VerticalAlignment="Top" RenderTransformOrigin="0.087,0.069">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,0">
                        <LineSegment Point="0,200" />
                        <LineSegment Point="375,200" />
                        <LineSegment Point="375,50"></LineSegment>
                        <LineSegment Point="300,10"></LineSegment>
                        <LineSegment Point="270,30"></LineSegment>
                        <LineSegment Point="200,15"></LineSegment>
                        <LineSegment Point="150,50"></LineSegment>
                        <LineSegment Point="119,20"></LineSegment>
                        <LineSegment Point="100,15"></LineSegment>
                        <LineSegment Point="60,45"></LineSegment>
                        <LineSegment Point="30,49"></LineSegment>
                        <LineSegment Point="0,12"></LineSegment>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        
        <TextBlock Text="Ime:" Margin="115,97,354,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtIme"  Margin="146,97,310,0" VerticalAlignment="Top"/>
        <TextBlock Text="Prezime:" Margin="115,123,332,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtPrezime"  Margin="168,123,273,0" VerticalAlignment="Top" Height="14"/>
        <TextBlock Text="Detalji:" Margin="306,61,-286,0" VerticalAlignment="Top"/>
        <Border BorderThickness="2" BorderBrush="Black" Margin="250,82,94,87" Padding="5">
            <RichTextBox x:Name="rtbDetalji" VerticalAlignment="Top" Height="150" IsReadOnly="True"></RichTextBox>
        </Border>
        <Image x:Name="SelectedImage" Margin="79,161,327,0" Height="80" VerticalAlignment="Top"/>
        <Button Content="Zatvori" Click="Zatvori_Click" Margin="190,250,190,10"/>
    </Grid>
</Window>
