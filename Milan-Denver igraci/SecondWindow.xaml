<Window x:Class="Milan_Denver_igraci.SecondWindow"
        x:Name="SecondWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:notifications="clr-namespace:Notification.Wpf.Controls;assembly=Notification.Wpf"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Width="900"
        Height="600"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <Border CornerRadius="20" Background="#0f172a" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.3"/>
        </Border.Effect>

        <Grid>

            <!-- NOTIFICATIONS -->
            <notifications:NotificationArea
                x:Name="SecondNotificationArea"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10"
                MaxItems="3"
                Panel.ZIndex="9999"/>

            <!-- HEADER -->
            <Grid Height="120" VerticalAlignment="Top" Panel.ZIndex="0">
                <Canvas>

                    <Polygon Points="0,100 150,20 300,100" Fill="#1e3a8a"/>
                    <Polygon Points="200,100 350,10 500,100" Fill="#1d4ed8"/>
                    <Polygon Points="400,100 550,30 700,100" Fill="#2563eb"/>

                    <TextBlock Text="Denver Club Management"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               Canvas.Left="20"
                               Canvas.Top="60"/>
                </Canvas>
            </Grid>

            <!-- MAIN -->
            <Grid Margin="0,120,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel Grid.Column="0" Margin="10">

                    <Image Source="Assets/jokic.png"
                           Height="120"
                           Margin="0,0,0,20"/>

                    <Button x:Name="AddButton"
                            Click="Add_click"
                            Content="Add"
                            Height="40"
                            Background="#22c55e"
                            Foreground="White"
                            Margin="0,0,0,10"/>

                    <Button x:Name="RemoveButton"
                            Click="Remove_click"
                            Content="Remove"
                            Height="40"
                            Background="#f59e0b"
                            Foreground="Black"
                            Margin="0,0,0,10"/>

                    <Button x:Name="ExitButton"
                            Click="Exit_Click"
                            Content="Exit"
                            Height="40"
                            Background="#ef4444"
                            Foreground="White"/>
                </StackPanel>

                <!-- DATA GRID -->
                <Border Grid.Column="1"
                        Background="#1e293b"
                        CornerRadius="10"
                        Padding="10"
                        Margin="10">

                    <DataGrid x:Name="dataGrid"
                              CanUserAddRows="False"
                              AutoGenerateColumns="False"
                              ItemsSource="{Binding Kosarkasi}"
                              SelectionChanged="dataGrid_SelectionChanged"
                              Background="#1e293b"
                              Foreground="White"
                              BorderThickness="0"
                              RowBackground="#1e293b"
                              AlternatingRowBackground="#334155">

                        <!-- HEADER STYLE -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="#60a5fa"/>
                                <Setter Property="Background" Value="#0f172a"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <!-- ROW STYLE -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#1e293b"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#334155"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2563eb"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <!-- CHECKBOX -->
                            <DataGridTemplateColumn Header="✔" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- LINK -->
                            <DataGridHyperlinkColumn Header="Player"
                                                     Binding="{Binding HyperlinkText}"
                                                     Width="*">
                                <DataGridHyperlinkColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <EventSetter Event="Hyperlink.Click" Handler="Hyperlink_Click"/>
                                        <Setter Property="Foreground" Value="#60a5fa"/>
                                    </Style>
                                </DataGridHyperlinkColumn.ElementStyle>
                            </DataGridHyperlinkColumn>

                            <!-- IMAGE -->
                            <DataGridTemplateColumn Header="Image" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding ImagePath}" Height="50"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- DATE -->
                            <DataGridTextColumn Header="Date Added"
                                                Binding="{Binding dateTime}"
                                                Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>